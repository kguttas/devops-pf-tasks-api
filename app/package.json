{
  "name": "tasks-api",
  "version": "1.0.0",
  "description": "API REST de tareas usada como aplicación de ejemplo del pipeline CI/CD (Proyecto Final DevOps)",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
